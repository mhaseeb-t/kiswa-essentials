{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/cat", "dest": "/index.js" },
    { "src": "/api/categories", "dest": "/index.js" },
    { "src": "/api/login", "dest": "/index.js" },
    { "src": "/api/register", "dest": "/index.js" },
    { "src": "/api/products/search", "dest": "/index.js" },
    { "src": "/api/products/?(.*)", "dest": "/index.js" },
    { "src": "/api/inventory/?(.*)", "dest": "/index.js" },
    { "src": "/api(.*)", "dest": "/index.js" }
  ]
}