{
  "projects": [
    {
      "path": "frontend",
      "config": {
        "buildCommand": "npm run build",
        "outputDirectory": "dist",
        "framework": "vite",
        "installCommand": "npm install",
        "devCommand": "npm run dev",
        "env": {
          "VITE_API_URL": "@kiswa-api-url"
        }
      }
    },
    {
      "path": "backend",
      "config": {
        "buildCommand": "",
        "installCommand": "npm install",
        "devCommand": "npm run dev:serverless",
        "env": {
          "DATABASE_URL": "@kiswa-db-url",
          "JWT_SECRET": "@kiswa-jwt-secret",
          "JWT_EXPIRE": "30d"
        }
      }
    }
  ]
}
